-- ===== Fungsi Jalankan Script Automation (WindUI) =====
local automationStarted = false

local function runAutomationScript()
    if automationStarted then
        warn("Automation script sudah berjalan.")
        return
    end
    automationStarted = true

    local ok, err = pcall(function()
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local UserInputService = game:GetService("UserInputService")
        local TeleportService = game:GetService("TeleportService")
        local HttpService = game:GetService("HttpService")

        local player = Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

        -- Memuat WindUI Library
        local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

        -- Membuat Window Utama WindUI
        local Window = WindUI:CreateWindow({
            Title = "Game Automation",
            Icon = "rbxassetid://6023426915",
            Author = "Automation Hub",
            Folder = "WindUI_Config",
            Size = UDim2.fromOffset(450, 350),
            Transparent = true,
            Theme = "Dark",
            Resizable = true,
        })

        local MainTab = Window:Tab({
            Title = "Main",
            Icon = "rbxassetid://6023426915",
        })

        local SettingsTab = Window:Tab({
            Title = "Settings",
            Icon = "rbxassetid://6023427145",
        })

        local activeStates = {eat = false, coin = false, jalur = false}
        local currentDelay = 0.1

        local locations = {
            ["Pacu Jalur"] = Vector3.new(160.82, 23.31, 253.25),
            ["Balap Karung"] = Vector3.new(-18.33, 21.74, 234.33),
            ["Tarik Tambang"] = Vector3.new(-84.36, 21.74, 222.81),
            ["Makan Pizza"] = Vector3.new(-99.02, 21.74, 6.89)
        }

        MainTab:Input({
            Title = "Delay (detik)",
            Default = "0.1",
            Placeholder = "Masukkan angka delay...",
            Callback = function(value)
                currentDelay = tonumber(value) or 0.1
            end
        })

        MainTab:Toggle({
            Title = "Auto Eat",
            Default = false,
            Callback = function(state)
                activeStates.eat = state
            end
        })

        MainTab:Toggle({
            Title = "Auto Coin",
            Default = false,
            Callback = function(state)
                activeStates.coin = state
            end
        })

        MainTab:Toggle({
            Title = "Auto Jalur",
            Default = false,
            Callback = function(state)
                activeStates.jalur = state
            end
        })

        local dropdownList = {}
        for name, _ in pairs(locations) do
            table.insert(dropdownList, name)
        end

        MainTab:Dropdown({
            Title = "Teleport Minigames",
            Values = dropdownList,
            Default = 1,
            Callback = function(selected)
                local targetPos = locations[selected]
                if targetPos and humanoidRootPart then
                    humanoidRootPart.CFrame = CFrame.new(targetPos)
                end
            end
        })

        SettingsTab:Slider({
            Title = "WalkSpeed",
            Step = 1,
            Value = {
                Min = 16,
                Max = 150,
                Default = 16
            },
            Callback = function(value)
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.WalkSpeed = value
                end
            end
        })

        SettingsTab:Button({
            Title = "Rejoin Server",
            Callback = function()
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, player)
                end)
            end
        })

        SettingsTab:Button({
            Title = "Server Hop (Low)",
            Callback = function()
                pcall(function()
                    local servers = {}
                    local req = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
                    if req and req.data then
                        for _, s in ipairs(req.data) do
                            if type(s) == "table" and s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                                table.insert(servers, s.id)
                            end
                        end
                    end
                    if #servers > 0 then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
                    else
                        WindUI:Notify({ Title = "Server Hop", Content = "Tidak ditemukan server lain yang kosong!", Duration = 3 })
                    end
                end)
            end
        })

        local isUIVisible = true
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if input.KeyCode == Enum.KeyCode.RightControl then
                isUIVisible = not isUIVisible
                Window:Toggle(isUIVisible)
            end
        end)

        task.spawn(function()
            while true do
                if activeStates.eat then
                    pcall(function()
                        ReplicatedStorage.GameRemoteEvents.GameCInputEvent:FireServer("Bite")
                    end)
                end
                task.wait(currentDelay)
            end
        end)

        task.spawn(function()
            while true do
                if activeStates.jalur then
                    pcall(function()
                        ReplicatedStorage.GameRemoteEvents.GameBInputEvent:FireServer("Paddle", "L")
                    end)
                    task.wait(currentDelay)
                    pcall(function()
                        ReplicatedStorage.GameRemoteEvents.GameBInputEvent:FireServer("Paddle", "R")
                    end)
                end
                task.wait(currentDelay)
            end
        end)
    end)

    if not ok then
        automationStarted = false
        warn("Gagal menjalankan automation script: " .. tostring(err))
    end
end

-- ===== Fungsi Teleport =====
local function teleportTo(path)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = workspace
    local ok = true
    for _, name in ipairs(path) do
        target = target:FindFirstChild(name)
        if not target then
            ok = false
            break
        end
    end

    if ok and target then
        local cf
        if target:IsA("BasePart") then
            cf = target.CFrame + Vector3.new(0, 3, 0)
        elseif target:IsA("Model") and target.PrimaryPart then
            cf = target.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
        end
        if cf then
            hrp.CFrame = cf
        end
    else
        warn("Target tidak ditemukan: " .. table.concat(path, "."))
    end
end

